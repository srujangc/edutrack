# EduTrack Environment Configuration

# Backend Server Port
PORT=5000

# MongoDB Connection String
# Can connect to a local MongoDB instance (mongodb://127.0.0.1:27017/edutrack)
# Or a cloud MongoDB Atlas URI.
# If no server is running, the backend automatically initializes an embedded in-memory MongoDB engine.
MONGODB_URI=mongodb://127.0.0.1:27017/edutrack

# JWT Secret for Token Signing
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# JWT Expiration Duration
JWT_EXPIRE=7d

# Environment
NODE_ENV=development

# Frontend API Base URL (Optional - defaults to http://localhost:5000/api in development)
VITE_API_URL=http://localhost:5000/api
