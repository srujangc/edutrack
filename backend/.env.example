# ============================================================
# EduTrack Backend — Environment Variables
# ============================================================

# MongoDB Atlas connection string (production)
# Get this from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://edutrack-admin:<password>@cluster0.xxxxx.mongodb.net/edutrack?retryWrites=true&w=majority

# JWT Secret — use a long random string (keep secret!)
JWT_SECRET=change_this_to_a_long_random_secret_string

# Server port (Render sets this automatically)
PORT=10000

# Node environment
NODE_ENV=production

# Your Firebase Hosting URL (optional — for CORS)
FRONTEND_URL=https://your-project.web.app
